[branch]
    sort = -committerdate

[column]
    ui = auto

[commit]
    verbose = true

[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    renames = true

[fetch]
    prune = true
    pruneTags = true
    all = true

[merge]
    conflictstyle = diff3

[pull]
    rebase = true

[push]
    default = simple
    autoSetupRemote = true

[rerere]
    enabled = true
    autoupdate = true

[rebase]
    autostash = true

[tag]
    sort = version:refname

[user]
	name = Patrick Grogan
	email = po.grogan@gmail.com
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = main
